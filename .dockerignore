# Only for images built from the repository root (deploy/Dockerfile). Everything is excluded
# except what that image copies, so .env, node_modules and virtual environments never enter
# the build context. The compose images use backend/, frontend/ and sandbox/ as contexts.
*
!backend/requirements.txt
!backend/app
!backend/alembic
!backend/alembic.ini
!backend/docker-entrypoint.sh
!deploy/start.sh
!security-rules/rules
!sandbox/requirements.txt
!sandbox/policy.py
!sandbox/server.py
**/__pycache__
