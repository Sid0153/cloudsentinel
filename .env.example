# Copy to .env and fill in the blanks. Never commit .env.
# Use URL-safe characters in POSTGRES_PASSWORD (it is placed inside a connection URL).

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=cloudsentinel
POSTGRES_DB=cloudsentinel

# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters, random (validated at startup).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Only when running the backend directly on your machine (outside Docker), for example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# AWS access (optional; only for scanning a real account). CloudSentinel uses the standard AWS
# credential chain. Never put access keys in this file. See docs/aws-permissions.md.
# Used by docker-compose.aws.yml:
# AWS_PROFILE=cloudsentinel
# AWS_CONFIG_DIR=C:/Users/you/.aws
